# Environment
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Browser Configuration
BROWSER_HEADLESS=false
BROWSER_USER_DATA_DIR=./data/browser-profile

# Discovery Configuration (Prompt 2)
DISCOVERY_MAX_KEYWORDS=10
DISCOVERY_MAX_RESULTS_PER_KEYWORD=50
DISCOVERY_SCROLL_COUNT=5
DISCOVERY_DELAY_MIN=1.5
DISCOVERY_DELAY_MAX=3.5

# Supabase Database Persistence (Prompt 4)
# Obtain these from Supabase Dashboard -> Project Settings -> API
# SUPABASE_URL: Project URL (e.g., https://your-project-ref.supabase.co)
# SUPABASE_KEY: Backend API Key (service-role or anon key for backend persistence - NEVER exposed to frontend)
SUPABASE_URL=
SUPABASE_KEY=

# Future modules (Prompts 3 & 5-6)
GEMINI_API_KEY=
