{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(styles\\.css|app\\.js|.*\\.png|.*\\.jpg|.*\\.svg)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/unsupported.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
